{
  "name": "conversation-coach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm -F @workspace/api dev\" \"pnpm -F @workspace/app dev\"",
    "dev:emulator": "concurrently -k -n firestore,dev \"pnpm firestore:emulator\" \"pnpm dev:with-emulator\"",
    "dev:with-emulator": "FIRESTORE_PROJECT_ID=convolab-dev FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 pnpm dev",
    "dev:landing": "pnpm -F @workspace/landing dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:api": "pnpm -F @workspace/api test",
    "firestore:emulator": "npx -y firebase-tools@latest emulators:start --only firestore",
    "firestore:seed:emulator": "FIRESTORE_PROJECT_ID=convolab-dev FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 pnpm -F @workspace/database seed",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@types/node": "^25.0.3",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "pnpm": "^11.9.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.6.0",
    "lucide-react": "^0.577.0",
    "react-google-recaptcha": "^3.1.0"
  }
}
