# Firestore
FIRESTORE_PROJECT_ID=your-firebase-project-id

# Optional local Firestore emulator.
# Leave unset for real Cloud Firestore. Set when running the emulator manually:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
#
# You can also use: pnpm dev:emulator

# Local Firestore auth uses Google Application Default Credentials.
# Run: gcloud auth application-default login

# API Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Frontend
FRONTEND_URL=http://localhost:5173
POST_SURVEY_URL=https://purdue.ca1.qualtrics.com/jfe/form/SV_cTT6h3GdIPz4LUG

# Session encryption key (must be exactly 64 hex characters = 32 bytes)
# Generate with: openssl rand -hex 32
SESSION_KEY=

# Google OAuth (get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# AI Providers
# ============
# At least one key is required for AI conversations.
#
# RECOMMENDED: Start with Anthropic. The app defaults to Claude models.
# Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=
#
# OPTIONAL: Additional providers for custom scenarios
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini via Vertex AI uses Application Default Credentials.
GOOGLE_CLOUD_PROJECT=your-firebase-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Optional fallback: Google AI Studio API key
GOOGLE_AI_API_KEY=
#
# Note: If you only configure OpenAI or Google AI (not Anthropic),
# you'll need to create custom scenarios that specify those providers,
# as the built-in scenarios use Claude models.

# Admin Bootstrap (comma-separated emails that get ADMIN role on OAuth login)
ADMIN_EMAILS=alice@example.com,bob@example.edu

# Optional: Site banner (HTML allowed, shown at top of every page)
# Example: "This prototype of the ConvoLab AI conversation coach is a project of <a href=\"https://github.com/GRAIL-center\">GRAIL</a>."
VITE_SITE_BANNER=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-site-key-here
RECAPTCHA_SECRET_KEY=your-secret-key-here

# Sentry error monitoring (optional — get DSN from sentry.io)
SENTRY_DSN=
