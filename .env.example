# Firestore
FIRESTORE_PROJECT_ID=your-firebase-project-id

# Optional local Firestore emulator.
# Leave unset for real Cloud Firestore. Set when running the emulator manually:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
#
# You can also use: pnpm dev:emulator

# Local Firestore auth uses Google Application Default Credentials.
# Run: gcloud auth application-default login

# API Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Frontend
FRONTEND_URL=http://localhost:5173
# The POST-survey participants are redirected to when they finish.
# NB: this previously pointed at the PRE-survey's id by mistake.
# Pre-survey (for reference; the app never links to it, Prolific does): https://harvard.az1.qualtrics.com/jfe/form/SV_9TQmgGn73T5VRoq
POST_SURVEY_URL=https://harvard.az1.qualtrics.com/jfe/form/SV_0J6ib9FF8hWhqEm

# Session encryption key (must be exactly 64 hex characters = 32 bytes)
# Generate with: openssl rand -hex 32
SESSION_KEY=

# Google OAuth (get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# AI Providers
# ============
# At least one key is required for AI conversations.
#
# RECOMMENDED: Start with Anthropic. The app defaults to Claude models.
# Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=
#
# OPTIONAL: Additional providers for custom scenarios
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini via Vertex AI uses Application Default Credentials.
GOOGLE_CLOUD_PROJECT=your-firebase-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Optional fallback: Google AI Studio API key
GOOGLE_AI_API_KEY=
#
# Note: If you only configure OpenAI or Google AI (not Anthropic),
# you'll need to create custom scenarios that specify those providers,
# as the built-in scenarios use Claude models.

# Admin Bootstrap (comma-separated emails that get ADMIN role on OAuth login)
ADMIN_EMAILS=alice@example.com,bob@example.edu

# Optional: Site banner (HTML allowed, shown at top of every page)
# Example: "This prototype of the ConvoLab AI conversation coach is a project of <a href=\"https://github.com/GRAIL-center\">GRAIL</a>."
VITE_SITE_BANNER=
# Client site key (Vite). Recaptcha.tsx reads VITE_RECAPTCHA_SITE_KEY, not NEXT_PUBLIC_*.
# Leave blank for local Docker: /practice skips the widget and the API fail-opens.
VITE_RECAPTCHA_SITE_KEY=
# API and share-link origins for the Capacitor (native app) build only.
# Leave unset for the web and local dev: paths stay relative and go through the
# Vite proxy. Vite does not read this file; pass them on the build command line.
# See packages/app/README.md.
#VITE_API_URL=https://convolab.us
#VITE_PUBLIC_URL=https://convolab.us
# Unused leftover from an older Next.js setup; the app does not read this.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Server copy of the same public site key. The API verifies tokens through the
# reCAPTCHA Enterprise assessment API using Application Default Credentials (no
# secret key). Outside production, leaving this blank skips verification; set it
# (and have ADC from `gcloud auth application-default login`) to test for real.
RECAPTCHA_SITE_KEY=

# Sentry error monitoring (optional — get DSN from sentry.io)
SENTRY_DSN=
