{
  "name": "@workspace/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "app:build": "VITE_NATIVE=1 VITE_API_URL=${VITE_API_URL:-https://convolab.us} VITE_PUBLIC_URL=${VITE_PUBLIC_URL:-https://convolab.us} pnpm build && cap sync",
    "app:ios": "cap open ios",
    "app:android": "cap open android",
    "preview": "vite preview",
    "test": "vitest --passWithNoTests",
    "lint": "biome lint .",
    "type-check": "tsc --noEmit",
    "app:assets": "capacitor-assets generate --ios --android --iconBackgroundColor '#f7faf9' --iconBackgroundColorDark '#11110f' --splashBackgroundColor '#f7faf9' --splashBackgroundColorDark '#11110f'"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@tanstack/react-query": "^5.90.16",
    "@trpc/client": "^11.8.1",
    "@trpc/tanstack-react-query": "^11.8.1",
    "@workspace/api": "workspace:*",
    "@workspace/database": "workspace:*",
    "lucide-react": "^0.577.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-google-recaptcha": "^3.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-google-recaptcha": "^2.1.9",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  }
}
