# Production build for API + static frontend
FROM node:22-slim AS builder

WORKDIR /app

# Install pnpm (pinned to match pnpm-lock.yaml version)
RUN npm install -g pnpm@10.28.2

# Copy workspace files
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages/database/package.json ./packages/database/
COPY packages/api/package.json ./packages/api/
COPY packages/app/package.json ./packages/app/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code (node_modules excluded via .dockerignore)
COPY packages/database ./packages/database
COPY packages/api ./packages/api
COPY packages/app ./packages/app

# Generate Prisma Client for legacy schema-derived types.
RUN pnpm -F @workspace/database generate

# Build database package (compile TypeScript for production)
RUN pnpm -F @workspace/database build

# Build args for Vite (baked into static build)
ARG VITE_SITE_BANNER
ENV VITE_SITE_BANNER=$VITE_SITE_BANNER
# Public reCAPTCHA site key for the practice landing at `/` (not a secret).
ARG VITE_RECAPTCHA_SITE_KEY
ENV VITE_RECAPTCHA_SITE_KEY=$VITE_RECAPTCHA_SITE_KEY

# Build API and App
RUN pnpm -F @workspace/api build
RUN pnpm -F @workspace/app build

# Copy frontend build into API's public directory
RUN cp -r packages/app/dist packages/api/dist/public

# Precompress text assets so fastify-static (preCompressed: true) can serve
# .gz variants with zero runtime CPU. gzip -k keeps the originals for
# clients that do not accept gzip.
RUN find packages/api/dist/public -type f \( -name '*.js' -o -name '*.css' -o -name '*.html' -o -name '*.svg' -o -name '*.webmanifest' \) -exec gzip -k -9 {} +

# Production image
FROM node:22-slim

WORKDIR /app

# Install pnpm (pinned to match pnpm-lock.yaml version)
RUN npm install -g pnpm@10.28.2

# Copy package files
COPY package.json pnpm-workspace.yaml ./
COPY packages/database/package.json ./packages/database/
COPY packages/api/package.json ./packages/api/

# Copy built artifacts and node_modules from builder
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/database ./packages/database
COPY --from=builder /app/packages/api/dist ./packages/api/dist
COPY --from=builder /app/packages/api/node_modules ./packages/api/node_modules

ENV NODE_ENV=production
EXPOSE 3000

CMD ["node", "packages/api/dist/server.js"]
